@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix martialis: <https://martial.is/ontology#> .
@prefix schema: <https://schema.org/> .
@prefix prov: <http://www.w3.org/ns/prov#> .

#################################################################
# Global settings
#################################################################

martialis:MartialisShapeGraph
    a sh:NodeShape ;
    sh:comment "SHACL shapes for validating Martialis RDF data" .

#################################################################
# Person
#################################################################

martialis:PersonShape
    a sh:NodeShape ;
    sh:targetClass martialis:Person ;

    sh:property [
        sh:path schema:name ;
        sh:minCount 1 ;
        sh:message "A Person must have at least one name."
    ] ;

    sh:property [
        sh:path schema:alternateName ;
        sh:nodeKind sh:Literal ;
        sh:message "Alternate names must be language-tagged string literals."
    ] ;

    sh:property [
        sh:path martialis:hasTeacherAssertion ;
        sh:class martialis:TeacherAssertion ;
        sh:message "teachers must be TeacherAssertion nodes."
    ] ;

    sh:property [
        sh:path martialis:hasRankAssertion ;
        sh:class martialis:RankAssertion ;
        sh:message "rank must be expressed via RankAssertion."
    ] ;

    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Person's birth date is after death date." ;
        sh:select """
            PREFIX martialis: <https://martial.is/ontology#>
            PREFIX schema: <https://schema.org/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT $this ?birthDate ?deathDate
            WHERE {
                $this martialis:birthEvent/schema:birthDate ?birthDate .
                $this martialis:deathEvent/schema:deathDate ?deathDate .
                FILTER(xsd:integer(SUBSTR(STR(?birthDate), 1, 4)) > xsd:integer(SUBSTR(STR(?deathDate), 1, 4)))
            }
        """
    ] .

#################################################################
# Assertion (base)
#################################################################

martialis:AssertionShape
    a sh:NodeShape ;
    sh:targetClass martialis:Assertion ;

    sh:property [
        sh:path martialis:subject ;
        sh:minCount 1 ;
        sh:class prov:Agent ;
        sh:message "Every Assertion must have a subject (Agent)."
    ] .
    # object requirement moved to specific assertion shapes

#################################################################
# TeacherAssertion
#################################################################

martialis:TeacherAssertionShape
    a sh:NodeShape ;
    sh:targetClass martialis:TeacherAssertion ;

    sh:property [
        sh:path martialis:subject ;
        sh:class martialis:Person ;
        sh:message "TeacherAssertion subject must be a Person."
    ] ;

    sh:property [
        sh:path martialis:object ;
        sh:minCount 1 ;
        sh:class martialis:Person ;
        sh:message "TeacherAssertion object must be a Person."
    ] ;

    sh:property [
        sh:path martialis:assertedStyle ;
        sh:class martialis:Style ;
        sh:message "Teacher assertion references non-existent style."
    ] ;

    sh:property [
        sh:path martialis:hasInteraction ;
        sh:class martialis:TeacherInteraction ;
        sh:message "Teacher interactions must be TeacherInteraction nodes."
    ] .

#################################################################
# TeacherInteraction
#################################################################

martialis:TeacherInteractionShape
    a sh:NodeShape ;
    sh:targetClass martialis:TeacherInteraction ;

    sh:property [
        sh:path martialis:interactionPlace ;
        sh:maxCount 1 ;
        sh:class martialis:Place ;
        sh:message "Interaction place must reference a Place."
    ] ;

    sh:property [
        sh:path martialis:interactionPeriod ;
        sh:maxCount 1 ;
        sh:class martialis:TimeInterval ;
        sh:message "Interaction period must be a TimeInterval."
    ] .

#################################################################
# RankAssertion
#################################################################

martialis:RankAssertionShape
    a sh:NodeShape ;
    sh:targetClass martialis:RankAssertion ;

    sh:property [
        sh:path martialis:subject ;
        sh:class martialis:Person ;
        sh:message "RankAssertion subject must be a Person."
    ] ;

    sh:property [
        sh:path martialis:object ;
        sh:minCount 1 ;
        sh:or (
            [ sh:class martialis:Style ]
            [ sh:class martialis:MartialArtRank ]
        ) ;
        sh:message "RankAssertion object must be a Style or MartialArtRank."
    ] ;

    sh:property [
        sh:path martialis:grantedBy ;
        sh:class martialis:Person ;
        sh:message "Rank granted_by references non-existent person."
    ] ;

    sh:property [
        sh:path martialis:assertedOrg ;
        sh:class martialis:Organization ;
        sh:message "Rank assertion references non-existent organization."
    ] .

    # Note: grantedBy is optional (often unknown)
    # Note: rankValue is optional (allows placeholder ranks for investigation)

#################################################################
# HonorAssertion
#################################################################

martialis:HonorAssertionShape
    a sh:NodeShape ;
    sh:targetClass martialis:HonorAssertion ;

    sh:property [
        sh:path martialis:subject ;
        sh:class martialis:Person ;
        sh:message "HonorAssertion subject must be a Person."
    ] ;

    sh:property [
        sh:path martialis:object ;
        sh:class martialis:Organization ;
        sh:message "HonorAssertion object must be an Organization."
    ] ;

    sh:property [
        sh:path martialis:assertedOrg ;
        sh:class martialis:Organization ;
        sh:message "Honor assertion references non-existent organization."
    ] .

    # Note: object (granting organization) is optional for honors without granting entity

#################################################################
# TimeInterval
#################################################################

martialis:TimeIntervalShape
    a sh:NodeShape ;
    sh:targetClass martialis:TimeInterval ;

    sh:property [
        sh:path martialis:startYear ;
        sh:datatype xsd:gYear ;
        sh:message "startYear must be a gYear."
    ] ;

    sh:property [
        sh:path martialis:endYear ;
        sh:datatype xsd:gYear ;
        sh:message "endYear must be a gYear."
    ] ;

    # Optional logical check (can be removed if engine lacks SPARQL)
    sh:sparql [
        sh:message "endYear must not be earlier than startYear." ;
        sh:select """
            SELECT $this
            WHERE {
              $this martialis:startYear ?s .
              $this martialis:endYear ?e .
              FILTER (?e < ?s)
            }
        """
    ] .

#################################################################
# SourceAssertionRelation (Evidence)
#################################################################

martialis:SourceAssertionRelationShape
    a sh:NodeShape ;
    sh:targetClass martialis:SourceAssertionRelation ;

    sh:property [
        sh:path martialis:basedOnSource ;
        sh:minCount 0 ;  # Optional - formal Sources to be created later
        sh:class martialis:Source ;
        sh:message "Evidence must reference a Source."
    ] ;

    sh:property [
        sh:path martialis:supports ;
        sh:minCount 1 ;
        sh:datatype xsd:boolean ;
        sh:message "Evidence must state whether it supports or contradicts the claim."
    ] ;

    sh:property [
        sh:path martialis:sourceRefType ;
        sh:in ( "primary" "secondary" "tertiary" "unknown" ) ;
        sh:datatype xsd:string ;
        sh:message "sourceRefType must be one of: primary, secondary, tertiary, unknown."
    ] .

# Note: "every Assertion must have at least one source" is enforced in
# martialis-quality.shacl.ttl as a quality warning, not a structural constraint.
# Structural SHACL covers referential integrity and semantic correctness;
# data completeness requirements belong in the quality tier.
