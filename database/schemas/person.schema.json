{
  "$id": "https://budotree.judoc.org/schemas/person.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema",
  "title": "Person",
  "description": "Information on a martial artist",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "@context": {
      "type": "string",
      "format": "uri",
      "description": "JSON-LD context URI for YAML-LD processing"
    },
    "type": {
      "type": "string",
      "const": "Person"
    },
    "id": {
      "type": "string",
      "pattern": "^JDP-[0-9]+$"
    },
    "name": {
      "$ref": "budotree.schema.json#/definitions/LanguageMap"
    },
    "aka": {
      "$ref": "budotree.schema.json#/definitions/LanguageMap"
    },
    "nationality": {
      "type": "array",
      "items": {
        "$ref": "budotree.schema.json#/definitions/NationalityEntry"
      }
    },
    "birth": {
      "$ref": "budotree.schema.json#/definitions/LifeEvent"
    },
    "death": {
      "$ref": "budotree.schema.json#/definitions/LifeEvent"
    },
    "description": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "budotree.schema.json#/definitions/Description"
        }
      ]
    },
    "notes": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "budotree.schema.json#/definitions/Notes"
        }
      ]
    },
    "photo": {
      "$ref": "budotree.schema.json#/definitions/Photo"
    },
    "teachers": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/Teacher"
      }
    },
    "rank": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/Rank"
      }
    },
    "honors": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/Honor"
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "budotree.schema.json#/definitions/SourceRef"
      }
    },
    "tags": {
      "$ref": "budotree.schema.json#/definitions/Tags"
    },
    "links": {
      "type": "array",
      "items": {
        "$ref": "budotree.schema.json#/definitions/Link"
      }
    }
  },
  "required": [
    "type",
    "id",
    "name",
    "nationality",
    "birth",
    "death",
    "teachers",
    "rank",
    "sources"
  ],
  "definitions": {
    "Interaction": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "place_id": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^JDP-P-[0-9]+$"
            }
          ],
          "description": "Place/venue ID for this interaction"
        },
        "period": {
          "$ref": "budotree.schema.json#/definitions/Period"
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "budotree.schema.json#/definitions/SourceRef"
          }
        }
      },
      "required": [
        "period"
      ],
      "title": "Interaction"
    },
    "Teacher": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^JDP-[0-9]+$"
            }
          ],
          "description": "Teacher person ID"
        },
        "style_id": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^JDP-S-[0-9]+$"
            }
          ],
          "description": "Style ID"
        },
        "role": {
          "type": "string",
          "enum": [
            "student",
            "uchi-deshi",
            "seminar",
            "private",
            "examination"
          ],
          "description": "Type of student-teacher relationship"
        },
        "confidence": {
          "$ref": "budotree.schema.json#/definitions/Confidence"
        },
        "interactions": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Interaction"
          },
          "minItems": 1,
          "description": "One or more place/period/source records for this teacher relationship"
        }
      },
      "required": [
        "interactions",
        "confidence"
      ],
      "title": "Teacher"
    },
    "Rank": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "style_id": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^JDP-S-[0-9]+$"
            }
          ],
          "description": "Style ID"
        },
        "rank": {
          "type": "string"
        },
        "rank_type": {
          "type": "string",
          "enum": [
            "dan",
            "kyu",
            "menkyo",
            "title",
            "other"
          ],
          "description": "Broad category of rank"
        },
        "org_id": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^JDP-O-[0-9]+$"
            }
          ],
          "description": "Organization ID"
        },
        "granted_by": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^JDP-[0-9]+$",
              "description": "Person ID of who granted the rank"
            }
          ]
        },
        "date": {
          "$ref": "budotree.schema.json#/definitions/BudoDate"
        },
        "confidence": {
          "$ref": "budotree.schema.json#/definitions/Confidence"
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "budotree.schema.json#/definitions/SourceRef"
          }
        }
      },
      "required": [
        "rank",
        "date",
        "confidence"
      ],
      "title": "Rank"
    },
    "Honor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "description": "Honor/title designation (e.g., Hanshi, Kyoshi)"
        },
        "honor_type": {
          "type": "string",
          "enum": [
            "title",
            "certificate",
            "noble_rank",
            "license",
            "other"
          ],
          "description": "Category of honor"
        },
        "org_id": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^JDP-O-[0-9]+$"
            }
          ],
          "description": "Granting organization ID"
        },
        "granted_by": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^JDP-[0-9]+$"
            }
          ]
        },
        "date": {
          "$ref": "budotree.schema.json#/definitions/BudoDate"
        },
        "confidence": {
          "$ref": "budotree.schema.json#/definitions/Confidence"
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "budotree.schema.json#/definitions/SourceRef"
          }
        }
      },
      "required": [
        "title",
        "date",
        "confidence"
      ],
      "title": "Honor"
    }
  }
}
