{
  "$id": "https://budotree.judoc.org/schemas/person.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema",
  "title": "Person",
  "description": "Information on a martial artist",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "person": {
      "$ref": "#/definitions/Person"
    }
  },
  "required": ["person"],
  "definitions": {
    "Person": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^JDP-[0-9]+$"
        },
        "name": {
          "type": "string"
        },
        "native_name": {
          "$ref": "budotree.schema.json#/definitions/NativeName"
        },
        "aka": {
          "$ref": "budotree.schema.json#/definitions/Aka"
        },
        "nationality": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
          }
        },
        "nationality_qid": {
          "type": "array",
          "items": {
            "$ref": "budotree.schema.json#/definitions/WikidataQID"
          }
        },
        "birth": {
          "$ref": "budotree.schema.json#/definitions/LifeEvent"
        },
        "death": {
          "$ref": "budotree.schema.json#/definitions/LifeEvent"
        },
        "description": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "budotree.schema.json#/definitions/Description"
            }
          ]
        },
        "notes": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "budotree.schema.json#/definitions/Notes"
            }
          ]
        },
        "photo": {
          "$ref": "budotree.schema.json#/definitions/Photo"
        },
        "teachers": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Teacher"
          }
        },
        "rank": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Rank"
          }
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "budotree.schema.json#/definitions/SourceRef"
          }
        },
        "tags": {
          "$ref": "budotree.schema.json#/definitions/Tags"
        },
        "links": {
          "type": "array",
          "items": {
            "$ref": "budotree.schema.json#/definitions/Link"
          }
        }
      },
      "required": [
        "id",
        "name",
        "nationality",
        "birth",
        "death",
        "teachers",
        "rank",
        "sources"
      ],
      "title": "Person"
    },
    "Teacher": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^JDP-[0-9]+$"
            }
          ],
          "description": "Teacher person ID"
        },
        "style_id": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^JDP-S-[0-9]+$"
            }
          ],
          "description": "Style ID"
        },
        "place_id": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^JDP-P-[0-9]+$"
            }
          ],
          "description": "Place/venue ID"
        },
        "period": {
          "$ref": "budotree.schema.json#/definitions/Period"
        },
        "role": {
          "type": "string",
          "enum": ["student", "uchi-deshi", "seminar", "private", "examination"],
          "description": "Type of student-teacher relationship"
        },
        "quality": {
          "$ref": "budotree.schema.json#/definitions/Quality"
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "budotree.schema.json#/definitions/SourceRef"
          }
        }
      },
      "required": [
        "period",
        "quality"
      ],
      "title": "Teacher"
    },
    "Rank": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "style_id": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^JDP-S-[0-9]+$"
            }
          ],
          "description": "Style ID"
        },
        "rank": {
          "type": "string"
        },
        "rank_type": {
          "type": "string",
          "enum": ["dan", "kyu", "menkyo", "title", "other"],
          "description": "Broad category of rank"
        },
        "org_id": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^JDP-O-[0-9]+$"
            }
          ],
          "description": "Organization ID"
        },
        "granted_by": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^JDP-[0-9]+$",
              "description": "Person ID of who granted the rank"
            }
          ]
        },
        "date": {
          "$ref": "budotree.schema.json#/definitions/BudoDate"
        },
        "quality": {
          "$ref": "budotree.schema.json#/definitions/Quality"
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "budotree.schema.json#/definitions/SourceRef"
          }
        }
      },
      "required": [
        "rank",
        "date"
      ],
      "title": "Rank"
    }
  }
}
