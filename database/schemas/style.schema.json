{
  "$id": "https://budotree.judoc.org/schemas/style.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema",
  "title": "Style",
  "description": "Information on a martial art style",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "@context": {
      "type": "string",
      "format": "uri",
      "description": "JSON-LD context URI for YAML-LD processing"
    },
    "type": {
      "type": "string",
      "const": "Style"
    },
    "id": {
      "type": "string",
      "pattern": "^JDP-S-[0-9]+$"
    },
    "name": {
      "type": "string"
    },
    "native_name": {
      "$ref": "budotree.schema.json#/definitions/NativeName"
    },
    "aka": {
      "$ref": "budotree.schema.json#/definitions/Aka"
    },
    "classification": {
      "type": "string",
      "enum": [
        "koryu",
        "gendai",
        "hybrid",
        "sport",
        "other"
      ],
      "description": "Classification of the martial art style"
    },
    "related_styles": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/StyleRelationship"
      },
      "description": "Typed relationships to other styles (lineage, influence, kinship)"
    },
    "founded": {
      "$ref": "#/definitions/StyleLifeEvent",
      "description": "When and where the style was founded"
    },
    "dissolved": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/definitions/StyleLifeEvent",
          "description": "When the style dissolved (null if still active)"
        }
      ]
    },
    "rank_system": {
      "$ref": "#/definitions/RankSystem"
    },
    "description": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "budotree.schema.json#/definitions/Description"
        }
      ]
    },
    "media": {
      "$ref": "#/definitions/Media"
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "budotree.schema.json#/definitions/SourceRef"
      }
    },
    "tags": {
      "$ref": "budotree.schema.json#/definitions/Tags"
    },
    "links": {
      "type": "array",
      "items": {
        "$ref": "budotree.schema.json#/definitions/Link"
      }
    }
  },
  "required": [
    "type",
    "id",
    "name",
    "founded",
    "sources"
  ],
  "definitions": {
    "StyleLifeEvent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "date": {
          "$ref": "budotree.schema.json#/definitions/BudoDate"
        },
        "place_id": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^JDP-P-[0-9]+$"
            }
          ],
          "description": "Place/venue ID where founded"
        },
        "geo": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "budotree.schema.json#/definitions/GeoRef"
            }
          ]
        },
        "founder_id": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^JDP-[0-9]+$",
              "description": "Person ID of founder"
            }
          ]
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "budotree.schema.json#/definitions/SourceRef"
          }
        }
      },
      "title": "StyleLifeEvent"
    },
    "RankSystem": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "dan-kyu",
            "menkyo",
            "military",
            "other"
          ],
          "description": "Type of ranking system"
        },
        "description": {
          "$ref": "budotree.schema.json#/definitions/Description"
        }
      },
      "title": "RankSystem"
    },
    "Media": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "photos": {
          "type": "array",
          "items": {
            "$ref": "budotree.schema.json#/definitions/Photo"
          }
        },
        "videos": {
          "type": "array",
          "items": {
            "$ref": "budotree.schema.json#/definitions/Video"
          }
        }
      },
      "title": "Media"
    },
    "StyleRelationship": {
      "title": "StyleRelationship",
      "description": "A typed relationship from this style to another style",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "style_id": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^JDP-S-[0-9]+$"
            }
          ],
          "description": "ID of the related style"
        },
        "type": {
          "type": "string",
          "enum": [
            "derived_from",
            "split_from",
            "influenced_by",
            "sibling_style_of"
          ],
          "description": "derived_from: direct technical lineage. split_from: conscious schism. influenced_by: partial influence. sibling_style_of: peer styles (symmetric, declare in both files)."
        },
        "confidence": {
          "$ref": "budotree.schema.json#/definitions/Confidence"
        },
        "notes": {
          "type": "string",
          "description": "Editorial annotation on what was transmitted or why this relationship matters"
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "budotree.schema.json#/definitions/SourceRef"
          }
        }
      },
      "required": [
        "style_id",
        "type",
        "confidence"
      ]
    }
  }
}
