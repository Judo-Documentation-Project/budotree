{
  "$id": "https://budotree.judoc.org/schemas/budotree.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema",
  "title": "Common definitions for the Budo Lineage Tree",
  "description": "Shared definitions for Budotree database v2",
  "type": "object",
  "definitions": {
    "BudoDate": {
      "title": "BudoDate",
      "description": "Flexible date representation: null (unknown), integer (year), ISO date string, or approximate year",
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        {
          "type": "string",
          "pattern": "^~[0-9]{4}$"
        }
      ]
    },
    "Quality": {
      "title": "Quality",
      "description": "Confidence/certainty rating: 0=Disputed, 1=Uncertain, 2=Probable, 3=Confirmed",
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "integer",
          "enum": [0, 1, 2, 3]
        }
      ]
    },
    "Confidence": {
      "title": "Confidence",
      "description": "Confidence assessment for an assertion",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "level": {
          "$ref": "#/definitions/Quality",
          "description": "Confidence level: 0=Disputed, 1=Uncertain, 2=Probable, 3=Confirmed"
        },
        "assessed_by": {
          "type": "string",
          "description": "Who performed the assessment (person, organization, or 'JDP' for project)"
        },
        "rationale": {
          "type": "string",
          "description": "Explanation for the confidence assessment"
        }
      },
      "required": ["level"]
    },
    "CountryCode": {
      "title": "CountryCode",
      "description": "ISO 3166-1 alpha-3 country code",
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        }
      ]
    },
    "WikidataQID": {
      "title": "WikidataQID",
      "description": "Wikidata entity identifier (Q-ID)",
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^Q[0-9]+$"
        }
      ]
    },
    "LanguageMap": {
      "type": "object",
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        ]
      },
      "title": "LanguageMap",
      "description": "BCP 47 language code to string(s) map"
    },
    "Period": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "start": {
          "$ref": "#/definitions/BudoDate"
        },
        "end": {
          "$ref": "#/definitions/BudoDate"
        }
      },
      "required": ["start"],
      "title": "Period"
    },
    "SourceRef": {
      "title": "SourceRef",
      "description": "Reference to a source - either by ID (preferred) or inline URI (fallback)",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "type": "string",
          "pattern": "^JDP-SRC-[0-9]+$"
        },
        "uri": {
          "type": "string",
          "format": "uri"
        },
        "cite": {
          "type": "string",
          "description": "Display citation text"
        },
        "location": {
          "type": "string",
          "description": "Location within the source (page, chapter, etc.)"
        },
        "quotation": {
          "type": "string",
          "description": "Direct quote from the source"
        },
        "events": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Which fields this source covers"
        },
        "type": {
          "type": "string",
          "enum": ["primary", "secondary", "tertiary", "unknown"],
          "description": "Type of source in terms of proximity to evidence"
        },
        "supports": {
          "type": "boolean",
          "description": "Whether this source supports (true) or disputes (false) the assertion"
        },
        "weight": {
          "type": "string",
          "enum": ["low", "medium", "high", "unknown"],
          "description": "Weight/importance of this source for the assertion"
        }
      },
      "oneOf": [
        {"required": ["source_id"]},
        {"required": ["uri"]}
      ]
    },
    "GeoRef": {
      "title": "GeoRef",
      "description": "Geographic reference with free-text display name, ISO country code, and Wikidata Q-IDs",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "location": {
          "type": "string",
          "description": "Display name for the location (city, region, etc.)"
        },
        "location_qid": {
          "$ref": "#/definitions/WikidataQID",
          "description": "Wikidata Q-ID for the geographic location"
        },
        "country_code": {
          "$ref": "#/definitions/CountryCode",
          "description": "ISO 3166-1 alpha-3 country code for filtering"
        },
        "country_qid": {
          "$ref": "#/definitions/WikidataQID",
          "description": "Wikidata Q-ID for country (handles historical countries)"
        }
      }
    },
    "LifeEvent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "date": {
          "$ref": "#/definitions/BudoDate"
        },
        "geo": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/definitions/GeoRef"
            }
          ]
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/SourceRef"
          }
        }
      },
      "title": "LifeEvent"
    },
    "Link": {
      "title": "Link",
      "description": "External identifier or linked data reference",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "uri": {
          "type": "string",
          "format": "uri"
        },
        "type": {
          "type": "string",
          "enum": ["wikidata", "dbpedia", "viaf", "isni", "wikipedia", "other"]
        },
        "cite": {
          "type": "string",
          "description": "Optional display label"
        }
      },
      "required": ["uri", "type"]
    },
    "Description": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "title": "Description",
      "description": "Multilingual description map (lang code → text)"
    },
    "Notes": {
      "type": "string",
      "title": "Notes"
    },
    "Photo": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "url": {
          "type": "string",
          "format": "uri"
        },
        "source": {
          "$ref": "#/definitions/SourceRef"
        }
      },
      "required": ["url", "source"],
      "title": "Photo"
    },
    "Video": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "url": {
          "type": "string",
          "format": "uri"
        },
        "source": {
          "$ref": "#/definitions/SourceRef"
        }
      },
      "required": ["url", "source"],
      "title": "Video"
    },
    "Tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Tags"
    }
  }
}
